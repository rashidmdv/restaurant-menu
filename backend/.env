# Production Environment Configuration
# Server Configuration
SERVER_PORT=8000
SERVER_HOST=0.0.0.0
SERVER_ENVIRONMENT=production
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# Database Configuration (using docker-compose postgres)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD_FILE=/run/secrets/db_password
DB_NAME=restaurant
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MAX_IDLE=5

# Storage Provider Configuration
STORAGE_PROVIDER=gcp
GCP_PROJECT_ID=your-gcp-project-id
GCP_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/gcp_service_account
GCP_BUCKET=restaurant-menu-images
GCP_REGION=us-central1

# Redis Configuration
REDIS_URL=redis://:$(cat /run/secrets/redis_password)@redis:6379
REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_DB=0

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Production Settings
DEBUG=false

# CORS Settings (for development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000

# File Upload Settings
MAX_UPLOAD_SIZE=10MB
ALLOWED_FILE_TYPES=jpg,jpeg,png,webp,gif

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60s

# Security Settings
ENABLE_SECURITY_HEADERS=true
CSRF_PROTECTION=true

# Database Migration Settings
AUTO_MIGRATE=false
RUN_SEED=false
